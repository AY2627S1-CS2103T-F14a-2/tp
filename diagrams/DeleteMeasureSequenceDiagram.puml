@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant ":DeleteMeasureCommandParser" as DeleteParser LOGIC_COLOR
participant "d:DeleteMeasureCommand" as Command LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "client:Person" as Client MODEL_COLOR
participant "updated:Person" as Updated MODEL_COLOR
end box
box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> Logic : execute("deletemeasure 1 d/2026-09-12 t/weight")
activate Logic
Logic -> Parser : parseCommand(...)
activate Parser
Parser -> DeleteParser : parse(arguments)
activate DeleteParser
create Command
DeleteParser -> Command : new(index, date, type)
DeleteParser --> Parser : d
deactivate DeleteParser
Parser --> Logic : d
deactivate Parser
note right of Logic : Snapshot address book and filter
Logic -> Command : execute(m)
activate Command
Command -> Model : getFilteredPersonList()
Model --> Command : displayedClients
Command -> Client : getMeasurements()
Client --> Command : measurements
note right of Command : Find record by date and type;
note right of Command : fail without changes if missing
Command -> Client : withoutMeasurement(date, type)
activate Client
create Updated
Client -> Updated : new(..., remainingMeasurements, ...)
Client --> Command : updated
deactivate Client
Command -> Model : setPerson(client, updated)
note right of Model : Observable cards refresh;
note right of Model : latest and count are derived
Command --> Logic : CommandResult(deletion message)
deactivate Command
Logic -> Storage : saveAddressBook(addressBook)
alt save succeeds
Storage --> Logic
Logic -->[ : deletion message
else save throws IOException
Storage --> Logic : IOException
Logic -> Model : setAddressBook(snapshot)
Logic -> Model : updateFilteredPersonList(previousFilter)
Logic -->[ : CommandException(save failure)
end
deactivate Logic
@enduml
