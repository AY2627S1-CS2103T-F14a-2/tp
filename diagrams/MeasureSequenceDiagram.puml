@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant ":MeasureCommandParser" as MeasureParser LOGIC_COLOR
participant "c:MeasureCommand" as Command LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "client:Person" as Client MODEL_COLOR
participant "updated:Person" as Updated MODEL_COLOR
end box
box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> Logic : execute("measure 1 d/2026-09-12 t/weight v/72.4")
activate Logic
Logic -> Parser : parseCommand("measure 1 d/2026-09-12 t/weight v/72.4")
activate Parser
create MeasureParser
Parser -> MeasureParser
activate MeasureParser
MeasureParser --> Parser
deactivate MeasureParser
Parser -> MeasureParser : parse(" 1 d/2026-09-12 t/weight v/72.4")
activate MeasureParser
note right of MeasureParser : Validates the index, date,\ntype and value
create Command
MeasureParser -> Command : MeasureCommand(index, measurement)
activate Command
Command --> MeasureParser
deactivate Command
MeasureParser --> Parser : c
deactivate MeasureParser
Parser --> Logic : c
deactivate Parser
note right of Logic : Keeps a copy of the address book,\nfilter and viewed client
Logic -> Command : execute(m)
activate Command
Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : displayed clients
deactivate Model
Command -> Client : findMeasurement(measurement)
activate Client
Client --> Command : previous
deactivate Client
note right of Command : previous is the record with the same\ndate and type, if any (Optional)
Command -> Client : withMeasurement(measurement)
activate Client
create Updated
Client -> Updated : Person(..., updatedMeasurements, ...)
activate Updated
Updated --> Client
deactivate Updated
Client --> Command : updated
deactivate Client
Command -> Model : setPerson(client, updated)
activate Model
Model --> Command
deactivate Model
Command --> Logic : result
deactivate Command
note right of Logic : result is a CommandResult: "Recorded ..."\nif previous is empty, else "Updated ..."
Logic -> Model : updateSessionLists(now)
activate Model
Model --> Logic
deactivate Model
opt address book changed
Logic -> Model : getAddressBook()
activate Model
Model --> Logic : addressBook
deactivate Model
Logic -> Storage : saveAddressBook(addressBook)
activate Storage
break IOException
Storage --> Logic : IOException
Logic -> Model : setAddressBook(copy)
activate Model
Model --> Logic
deactivate Model
Logic -> Model : updateFilteredPersonList(previousFilter)
activate Model
Model --> Logic
deactivate Model
Logic -> Model : setViewedPerson(previousViewedClient)
activate Model
Model --> Logic
deactivate Model
[<-- Logic : CommandException(save failure)
end
Storage --> Logic
deactivate Storage
end
[<-- Logic : result
deactivate Logic
@enduml
