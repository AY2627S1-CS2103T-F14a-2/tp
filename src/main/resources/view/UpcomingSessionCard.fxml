<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" minWidth="10" prefWidth="150">
    <padding>
      <Insets top="5" right="5" bottom="5" left="15" />
    </padding>
    <Label fx:id="sessionTime" styleClass="cell_big_label" />
    <Label fx:id="name" styleClass="cell_small_label" wrapText="true" />
    <Label fx:id="phone" styleClass="cell_small_label" />
    <Label fx:id="latestMeasurement" styleClass="cell_small_label" wrapText="true" />
    <Label fx:id="latestPerformance" styleClass="cell_small_label" wrapText="true" />
  </VBox>
</HBox>
