<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" styleClass="client-card"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" spacing="3" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="10" right="12" bottom="10" left="12" />
      </padding>
      <HBox spacing="0.5" alignment="TOP_LEFT">
        <Label fx:id="id" styleClass="card-title">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="card-title" wrapText="true" HBox.hgrow="ALWAYS" />
      </HBox>
      <FlowPane fx:id="tags" />
      <Label fx:id="phone" styleClass="card-detail" text="\$phone" wrapText="true" />
      <Label fx:id="email" styleClass="card-detail" text="\$email" wrapText="true" />
      <Label fx:id="nextSession" styleClass="card-session" wrapText="true" text="Next session: - (none booked)" />
      <Label fx:id="latestMeasurement" styleClass="card-detail" text="Latest measurement: -"
             wrapText="true" />
      <Label fx:id="latestPerformance" styleClass="card-detail" text="Latest performance: -"
             wrapText="true" />
    </VBox>
  </GridPane>
</HBox>
