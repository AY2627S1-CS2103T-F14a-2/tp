@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant ":DeleteMeasureCommandParser" as DeleteParser LOGIC_COLOR
participant "d:DeleteMeasureCommand" as Command LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "client:Person" as Client MODEL_COLOR
participant "updated:Person" as Updated MODEL_COLOR
end box
box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> Logic : execute("deletemeasure 1 d/2026-09-12 t/weight")
activate Logic
Logic -> Parser : parseCommand("deletemeasure 1 d/2026-09-12 t/weight")
activate Parser
create DeleteParser
Parser -> DeleteParser
activate DeleteParser
DeleteParser --> Parser
deactivate DeleteParser
Parser -> DeleteParser : parse(" 1 d/2026-09-12 t/weight")
activate DeleteParser
create Command
DeleteParser -> Command : DeleteMeasureCommand(index, date, type)
activate Command
Command --> DeleteParser
deactivate Command
DeleteParser --> Parser : d
deactivate DeleteParser
Parser --> Logic : d
deactivate Parser
note right of Logic : Keeps a copy of the address book,\nfilter and viewed client
Logic -> Command : execute(m)
activate Command
Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : displayed clients
deactivate Model
Command -> Client : getMeasurements()
activate Client
Client --> Command : measurements
deactivate Client
note right of Command : Finds the record with this date and type;\nthrows CommandException, changing nothing, if none
Command -> Client : withoutMeasurement(date, type)
activate Client
create Updated
Client -> Updated : Person(..., remainingMeasurements, ...)
activate Updated
Updated --> Client
deactivate Updated
Client --> Command : updated
deactivate Client
Command -> Model : setPerson(client, updated)
activate Model
note right of Model : Observable cards and open history refresh;\nlatest and count are derived
Model --> Command
deactivate Model
Command --> Logic : result
deactivate Command
Logic -> Model : updateSessionLists(now)
activate Model
Model --> Logic
deactivate Model
opt address book changed
Logic -> Model : getAddressBook()
activate Model
Model --> Logic : addressBook
deactivate Model
Logic -> Storage : saveAddressBook(addressBook)
activate Storage
alt saved
Storage --> Logic
else IOException
Storage --> Logic : IOException
deactivate Storage
Logic -> Model : setAddressBook(copy)
activate Model
Model --> Logic
deactivate Model
Logic -> Model : updateFilteredPersonList(previousFilter)
activate Model
Model --> Logic
deactivate Model
Logic -> Model : setViewedPerson(previousViewedClient)
activate Model
Model --> Logic
deactivate Model
[<-- Logic : CommandException(save failure)
end
end
note right of Logic : result is returned only if the save\nsucceeded or nothing changed
[<-- Logic : result
deactivate Logic
@enduml
